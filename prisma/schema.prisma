// Schéma Prisma — Momentum
// Base : PostgreSQL (Neon). Auth gérée par Auth.js (modèles User/Account/Session/VerificationToken
// imposés par @auth/prisma-adapter, ne pas renommer leurs champs).

generator client {
  provider = "prisma-client-js"
}

// L'URL de connexion est configurée dans prisma.config.ts (Prisma 7), pas ici.
datasource db {
  provider = "postgresql"
}

// ————————————————————————————————————————————————
// Auth.js — ne pas modifier la forme de ces 4 modèles
// ————————————————————————————————————————————————

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // credentials provider (email + mot de passe)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  profile           Profile?
  exercises         Exercise[]
  workoutSessions   WorkoutSession[]
  cardioSessions    CardioSession[]
  bodyMeasurements  BodyMeasurement[]
  dailyMetrics      DailyMetric[]
  goals             Goal[]
  userBadges        UserBadge[]
  restDays          RestDay[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ————————————————————————————————————————————————
// Domaine Momentum
// ————————————————————————————————————————————————

enum Objectif {
  PERTE_DE_POIDS
  PRISE_DE_MUSCLE
  RECOMPOSITION
  ENDURANCE
  FORCE
  SANTE_GENERALE
}

// Profil rempli à l'onboarding : point de départ de référence pour toutes les comparaisons.
model Profile {
  id            String    @id @default(cuid())
  userId        String    @unique
  prenom        String
  tailleCm      Float?
  poidsDepartKg Float?
  dateNaissance DateTime?
  objectifs     Objectif[]

  // Mensurations de départ (optionnelles), en cm
  tourTailleDepartCm   Float?
  tourHanchesDepartCm  Float?
  tourPoitrineDepartCm Float?
  tourBrasDepartCm     Float?
  tourCuissesDepartCm  Float?
  tourMolletsDepartCm  Float?
  tourCouDepartCm      Float?

  dateDepart DateTime @default(now()) // date du "point de départ" pour les comparaisons

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum GroupeMusculaire {
  PECTORAUX
  DOS
  EPAULES
  BICEPS
  TRICEPS
  AVANT_BRAS
  QUADRICEPS
  ISCHIOS
  FESSIERS
  MOLLETS
  ABDOMINAUX
  LOMBAIRES
  CARDIO
  FULL_BODY
}

// Bibliothèque d'exercices : userId = null → exercice global (seed), sinon exercice créé par l'utilisateur.
model Exercise {
  id               String           @id @default(cuid())
  nom              String
  groupeMusculaire GroupeMusculaire
  userId           String?
  createdAt        DateTime         @default(now())

  user User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets WorkoutSet[]

  @@index([groupeMusculaire])
  @@index([userId])
  @@map("exercises")
}

enum TypeSeance {
  PUSH
  PULL
  LEGS
  UPPER
  LOWER
  FULL_BODY
  PERSONNALISE
}

model WorkoutSession {
  id            String     @id @default(cuid())
  userId        String
  type          TypeSeance
  nomPersonnalise String? // utilisé quand type = PERSONNALISE
  date          DateTime   @default(now())
  dureeSecondes Int?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets WorkoutSet[]

  @@index([userId, date])
  @@map("workout_sessions")
}

model WorkoutSet {
  id               String  @id @default(cuid())
  workoutSessionId String
  exerciseId       String
  ordre            Int // position dans la séance, pour l'affichage et la duplication
  repetitions      Int
  chargeKg         Float
  rpe              Float?
  note             String?

  createdAt DateTime @default(now())

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id])

  @@index([workoutSessionId])
  @@index([exerciseId])
  @@map("workout_sets")
}

enum TypeCardio {
  FOOTING
  FRACTIONNE
  SORTIE_LONGUE
  TEMPO
  VELO
  NATATION
  MARCHE
  RAMEUR
  AUTRE
}

model CardioSession {
  id             String     @id @default(cuid())
  userId         String
  type           TypeCardio
  nomPersonnalise String? // utilisé quand type = AUTRE, propre à l'utilisateur qui l'a saisi
  date           DateTime   @default(now())
  distanceKm     Float?
  dureeSecondes  Int
  deniveleM      Int?
  frequenceCardiaqueMoyenne Int?
  ressenti       Int? // 1 à 5
  note           String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("cardio_sessions")
}

model BodyMeasurement {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @default(now())
  poidsKg           Float?
  masseGrassePct    Float?
  tourTailleCm      Float?
  tourHanchesCm     Float?
  tourPoitrineCm    Float?
  tourBrasCm        Float?
  tourCuissesCm     Float?
  tourMolletsCm     Float?
  tourCouCm         Float?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("body_measurements")
}

model DailyMetric {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @default(now())
  pas             Int?
  sommeilHeures   Float?
  qualiteSommeil  Int? // 1 à 5
  proteinesG      Float?
  hydratationL    Float?
  energie         Int? // 1 à 5 (énergie / humeur)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_metrics")
}

// Jour marqué explicitement comme repos par l'utilisateur : compte comme une
// activité pour le streak de régularité, sans être une vraie séance.
model RestDay {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("rest_days")
}

enum TypeObjectif {
  POIDS
  MENSURATION
  CHARGE_EXERCICE
  ALLURE
  DISTANCE_HEBDO
  VOLUME_HEBDO
  PERSONNALISE
}

model Goal {
  id            String       @id @default(cuid())
  userId        String
  type          TypeObjectif
  titre         String
  valeurDepart  Float?
  valeurCible   Float
  unite         String // "kg", "cm", "min/km", "km", etc.
  exerciceId    String? // pour TypeObjectif.CHARGE_EXERCICE
  dateCible     DateTime?
  atteint       Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

// Définitions globales des badges (catalogue fixe, pas lié à un utilisateur).
model Badge {
  id          String   @id @default(cuid())
  cle         String   @unique // ex: "premiere-seance", "streak-7-jours"
  nom         String
  description String
  icone       String // nom d'icône lucide-react

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  debloqueLe DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}
