# Base de données PostgreSQL (Neon) — https://neon.tech
# En local : utilise la branche Neon "dev" (les tests e2e créent de vrais comptes).
# En production (Vercel) : la branche "production". Ne jamais mettre l'URL de prod dans un .env local.
# Chaîne "pooled" (PgBouncer) : Prisma 7 s'en sert pour les migrations comme pour les requêtes.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/momentum?sslmode=require"

# Auth.js — générer un secret avec : npx auth secret
AUTH_SECRET=""
# URL publique du site (sert à construire le lien de réinitialisation de mot de passe).
# Inutile sur Vercel sans domaine personnalisé : l'URL Vercel est alors détectée automatiquement.
NEXTAUTH_URL="http://localhost:3000"

# Resend — envoi d'e-mails (mot de passe oublié) — https://resend.com
# EMAIL_FROM doit utiliser un domaine vérifié sur resend.com/domains : avec
# onboarding@resend.dev, Resend n'envoie qu'à l'adresse du propriétaire du compte.
RESEND_API_KEY=""
EMAIL_FROM="Momentum <onboarding@resend.dev>"
