# Base de données PostgreSQL (Neon) — https://neon.tech
# En local : utilise la branche Neon "dev" (les tests e2e créent de vrais comptes).
# En production (Vercel) : la branche "production". Ne jamais mettre l'URL de prod dans un .env local.
# Chaîne "pooled" (PgBouncer) : Prisma 7 s'en sert pour les migrations comme pour les requêtes.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/momentum?sslmode=require"

# Auth.js — générer un secret avec : npx auth secret
AUTH_SECRET=""
# URL publique du site (sert à construire le lien de réinitialisation de mot de passe).
# Inutile sur Vercel sans domaine personnalisé : l'URL Vercel est alors détectée automatiquement.
NEXTAUTH_URL="http://localhost:3000"

# E-mails (mot de passe oublié). Choisir UN service ; le SMTP est prioritaire s'il est complet.
# Option A — SMTP, sans nom de domaine : une boîte Gmail dédiée avec un « mot de passe d'application »
# (16 caractères, validation en deux étapes requise sur le compte Google).
# En développement, sans aucun service : le lien est affiché dans le terminal.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Option B — Resend : sans domaine vérifié sur resend.com/domains, n'envoie qu'au propriétaire du compte.
RESEND_API_KEY=""
# Expéditeur (facultatif : par défaut l'adresse SMTP_USER). Soit absent, soit renseigné, jamais vide.
# EMAIL_FROM="Momentum <contact@ton-domaine.fr>"


# Confirmation de l'adresse e-mail à l'inscription : exigée par défaut. Ne mettre "false" qu'en développement
# local sans service d'e-mail (sans service, le lien de confirmation s'affiche déjà dans le terminal).
# REQUIRE_EMAIL_VERIFICATION="false"
